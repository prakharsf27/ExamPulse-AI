# ExamPulse AI Configuration
# Copy this file to .env (or backend/.env) and fill in your API keys.
# The app also runs out-of-the-box in local fallback mode without any keys!

# Primary LLM & Embeddings (Google Gemini - Free Tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Secondary Fast LLM for Quiz Generation (Groq - Optional, falls back to Gemini)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Vector Database (Qdrant Cloud - Optional, falls back to local :memory: mode)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=exampulse_rag

# State Persistence (Supabase - Optional, falls back to local JSON + in-memory)
SUPABASE_URL=
SUPABASE_KEY=

# Frontend -> Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
