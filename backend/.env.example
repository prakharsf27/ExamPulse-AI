# ExamPulse AI Backend Configuration
# Copy to .env inside /backend and fill in your API keys.
# Runs out-of-the-box with Qdrant :memory: and local fallbacks if keys are omitted.

GEMINI_API_KEY=
GROQ_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=

# Gmail SMTP Email Delivery (Use a 16-char Google App Password)
SMTP_EMAIL=ivarbonless56@gmail.com
SMTP_APP_PASSWORD=fevb djak efde eoah

# Production Frontend URL for CORS (e.g. https://exampulse-ai.vercel.app)
FRONTEND_URL=

# Optional tuning
USE_LOCAL_EMBEDDINGS=false
GEMINI_PARSER_MODEL=gemini-3.5-flash-lite
GEMINI_GENERATOR_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GROQ_MODEL=llama-3.3-70b-versatile
QDRANT_COLLECTION=exampulse_rag
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
